# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave "service_role" (ou "secret"). NUNCA coloque NEXT_PUBLIC_ na frente: ela só vive no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# PIN da equipe da recepção (só marca presença)
STAFF_PIN=1234
# PIN da organização (marca presença + importa lista + forma grupos)
ADMIN_PIN=troque-este-pin

# Texto aleatório longo (32+ caracteres) usado para assinar o login. Gere com: openssl rand -hex 32
SESSION_SECRET=
